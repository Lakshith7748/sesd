# ===========================================
# FRONTEND ENVIRONMENT VARIABLES (DEPLOYMENT)
# ===========================================

# The base URL pointing to the deployed backend API.
# Note: For Vite, environment variables MUST be prefixed with VITE_ to be exposed to the application.
# Example: https://my-backend-api.onrender.com/api
VITE_API_BASE_URL=https://your-production-backend-domain.com/api
