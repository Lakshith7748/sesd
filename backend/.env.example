# ==========================================
# BACKEND ENVIRONMENT VARIABLES (DEPLOYMENT)
# ==========================================

# Port the backend server will run on (Usually overridden by the hosting provider e.g., Render/Heroku)
PORT=5050

# MongoDB Connection String (Replace with your production MongoDB Atlas URI)
MONGO_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/<DATABASE>?retryWrites=true&w=majority

# JSON Web Token Secret for secure authentication (Use a strong, random 256-bit string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Runtime Environment. Set to 'production' to enforce strict CORS and security rules
NODE_ENV=production

# Allowed CORS Origins (Replace with your deployed frontend URL)
# Example: https://my-freelancer-app.vercel.app
CORS_ORIGINS=https://your-production-frontend-domain.com
